#!/usr/bin/env bash

set -e

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Common config first, then the one for this OS (install.darwin.conf.yaml, install.linux.conf.yaml)
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
CONFIGS=("install.conf.yaml")
if [[ -f "${BASEDIR}/install.${OS}.conf.yaml" ]]; then
  CONFIGS+=("install.${OS}.conf.yaml")
else
  echo "No install.${OS}.conf.yaml: only linking dotfiles, install packages manually." >&2
fi

# Homebrew is not on PATH yet in the shell that just installed it (bootstrap.sh, fresh macOS)
if [[ "${OS}" == "darwin" ]] && ! command -v brew > /dev/null; then
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "${brew}" ]] && eval "$("${brew}" shellenv)" && break
  done
fi

cd "${BASEDIR}"
git submodule update --init --recursive "${DOTBOT_DIR}"

# Fresh macOS/Ubuntu ship their own ~/.bashrc, ~/.gitconfig..., and dotbot will not replace
# regular files. Move any link target that is not already a symlink to ~/.dotfiles_backup/<date>/.
BACKUP_DIR="${HOME}/.dotfiles_backup/$(date +%Y%m%d-%H%M%S)"
while IFS= read -r target; do
  target="${HOME}/${target#\~/}"
  if [[ -e "${target}" && ! -L "${target}" ]]; then
    mkdir -p "${BACKUP_DIR}/$(dirname "${target#"${HOME}"/}")"
    mv "${target}" "${BACKUP_DIR}/${target#"${HOME}"/}"
    echo "Backed up ${target} to ${BACKUP_DIR}/"
  fi
done < <(sed -n 's/^ *\(~\/[^:]*\):.*/\1/p' "${CONFIGS[@]}")

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIGS[@]}" "${@}"
