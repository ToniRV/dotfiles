#!/usr/bin/env bash
# Make Homebrew's bash 5 the login shell (Terminal, VS Code, ssh...), not only iTerm2's.
set -euo pipefail

shell="$(brew --prefix)/bin/bash"
[[ -x "$shell" ]] || { echo "$shell not found: run brew bundle first" >&2; exit 1; }

current="$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')"
if [[ "$current" == "$shell" ]]; then
  echo "Login shell is already $shell"
  exit 0
fi

# chsh only accepts shells listed in /etc/shells
grep -qxF "$shell" /etc/shells || echo "$shell" | sudo tee -a /etc/shells > /dev/null
sudo chsh -s "$shell" "$USER"
echo "Login shell changed from $current to $shell (applies to new terminals)"
