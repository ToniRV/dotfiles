#!/bin/bash

# Platform specific aliases (clipboard, network, ...) live in ~/.bash.d/os/

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Reload the shell (i.e. invoke bash as a login shell; $SHELL may be zsh)
alias reload='exec "$BASH" -l'

# Easier navigation: .., ..., ...., ....., ~ and -
alias cd..='cd ..'
alias ~="cd ~"
alias -- -='cd -'
alias ..='cd ..'
alias ...='cd ../..'
alias ..2='cd ../..'
alias ..3='cd ../../..'
alias ..4='cd ../../../..'
alias ..5='cd ../../../../..'
alias ..6='cd ../../../../../..'

# Shortcuts
alias desktop='cd ~/Desktop'
alias downloads='cd ~/Downloads'
alias workspaces='cd ~/Workspaces'

# So lazy am i
alias g='git'
alias gc='git commit -m'
alias h='history'
alias j='jobs'

# Open the files with git conflicts in vim
alias fix='git diff --name-only --diff-filter=U | uniq | xargs -o vim'

# Always use color output for `ls` (GNU and macOS >= 13 ls; older macOS uses -G)
if ls --color=auto -d . &> /dev/null; then
  alias ls='ls --color=auto'
else
  alias ls='ls -G'
fi
# List all files colorized in long format
alias l='ls -lhF'
# List all files colorized ordered by last modified
alias lt='ls -t'
# List all files colorized in long format, including dot files
alias la='ls -lhAF'
# List only directories
alias lsd='ls -lhF | grep --color=never "^d"'

# Shortcut to remove all with force
alias rmf='rm -rf'

# Folder manipulation
alias md='mkdir -p'
alias rd='rmdir'
alias d='dirs -v | head -10'

# Always use color output for `grep`
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# tmux aliases
alias ta='tmux attach'
alias tls='tmux ls'
alias tat='tmux attach -t'
alias tns='tmux new-session -s'

# Print path directories
alias path='echo -e ${PATH//:/\\n}'

# Get week number
alias week='date +%V'

# Stopwatch
alias timer='e_header "Timer started. Stop with Ctrl-D." && date && time cat && date'

# Intuitive map function
# For example, to list all directories that contain a certain file:
# find . -name .gitattributes | map dirname
alias map='xargs -n1'

# Trim new lines and copy to clipboard
alias c='tr -d "\n" | pbcopy'

# Copy my public key to the pasteboard
function pubkey() {
  local key
  for key in ~/.ssh/id_ed25519.pub ~/.ssh/id_ecdsa.pub ~/.ssh/id_rsa.pub; do
    if [[ -r "$key" ]]; then
      pbcopy < "$key" && e_success "Public key ${key##*/} copied to pasteboard."
      return
    fi
  done
  e_error "No public key found in ~/.ssh"
  return 1
}

# Usage: c++11 main.cpp
alias c++11='c++ -std=c++11'

# Public IP address (localip, ips: see os/)
alias myip='dig +short myip.opendns.com @resolver1.opendns.com'

# Show all open TCP/IP sockets
alias netcons='sudo lsof -i'

# Display open sockets
alias lsock='sudo lsof -i -P'

# Display only open UDP sockets
alias lsock-ucp='sudo lsof -nP | grep UDP'

# Display only open TCP sockets
alias lsock-tcp='sudo lsof -nP | grep TCP'

# All listening connections
alias lsock-opened='sudo lsof -i | grep LISTEN'

# One of @janmoesen’s ProTip™s
if type_exists lwp-request; then
  for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
    alias "$method"="lwp-request -m '$method'"
  done
  unset method
fi

# URL-encode strings
alias urlencode='python3 -c "import sys, urllib.parse as ul; print(ul.quote_plus(sys.argv[1]))"'

# Build a CMake project in ./build (scripts live in ~/.bash.d/bin)
alias cbc="cbuild --clean"
alias cbt="cbuild --test"

# source bashrc
alias sbash="source ~/.bashrc"

# Activate the virtualenv of the current directory
alias svenv="source ./venv/bin/activate"
