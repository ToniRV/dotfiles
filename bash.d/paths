#!/bin/bash

# Set path by prepending and appending directories.
# Missing directories are skipped silently (see path_prepend in utils).

# Directories to be prepended to PATH (last one ends up first)
declare -a dirs_to_prepend=(
  "${HOME}/.local/bin"     # pip --user, pipx, uv tools...
  "${HOME}/.bash.d/bin"    # Scripts shipped with these dotfiles
)

# Directories to be appended to PATH
declare -a dirs_to_append=(
)

for dir in "${dirs_to_prepend[@]}"; do path_prepend "$dir"; done
for dir in "${dirs_to_append[@]}"; do path_append "$dir"; done

unset dir dirs_to_prepend dirs_to_append

export PATH
