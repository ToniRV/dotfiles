#!/bin/bash

# Set terminal title
function set_title() {
  echo -e "\[\033]0;\w\007\]";
}

# Set a few globals to compute prompt string length
function prompt_update() {
  # One machine-readable `git status` call gives branch, ahead/behind and
  # file states (locale independent, unlike parsing the human output).
  branch=""; status=""; remote="";
  local line oid="" ahead=0 behind=0 unstaged="" staged="" untracked="" stashed="";
  while IFS= read -r line; do
    case "$line" in
      "# branch.oid "*)  oid="${line#\# branch.oid }" ;;
      "# branch.head "*) branch="${line#\# branch.head }" ;;
      "# branch.ab "*)   read -r _ _ ahead behind <<< "$line"; ahead="${ahead#+}"; behind="${behind#-}" ;;
      [12]" "*)          [[ "${line:2:1}" != "." ]] && staged="+"; [[ "${line:3:1}" != "." ]] && unstaged="●" ;;
      "u "*)             unstaged="●" ;;
      "? "*)             untracked="?" ;;
    esac
  done < <(git status --porcelain=v2 --branch --ignore-submodules 2> /dev/null)

  if [[ -n "$branch" ]]; then
    [[ "$branch" == "(detached)" ]] && branch="${oid:0:7}";
    git rev-parse --verify --quiet refs/stash &> /dev/null && stashed="⚑";

    local s="${unstaged}${staged}${untracked}${stashed}";
    if [[ -z "$s" ]]; then
      status=" ✔";
    else
      status=" [${s}]";
    fi;

    if (( ahead > 0 && behind > 0 )); then
      remote=" [↑${ahead}↓${behind}]";
    elif (( ahead > 0 )); then
      remote=" [↑${ahead}]";
    elif (( behind > 0 )); then
      remote=" [↓${behind}]";
    fi;
  fi;

  gitLength=$((${#branch}+${#status}+${#remote}));

  # Check if we're in a virtualenv
  if [[ -n "$VIRTUAL_ENV" ]]; then
    venv="$(basename "${VIRTUAL_ENV}") ";
  fi;
  if [[ -n "$CONDA_PREFIX" ]]; then
    venv="$(basename "${CONDA_PREFIX}") ";
  fi;
  if [[ -z "$VIRTUAL_ENV"  && -z "$CONDA_PREFIX" ]]; then
    venv="";
  fi;


  # Check if we have sourced a ros workspace
  if [[ -n "$ROSLISP_PACKAGE_DIRECTORIES" ]]; then
    # Parse catkin_workspace env variable, to get all workspaces.
    IFS=: read -r -d '' -a path_array < <(printf '%s:\0' "$ROSLISP_PACKAGE_DIRECTORIES")
    ros_ws=""
    for workspace in "${path_array[@]}"; do
      ros_ws="$ros_ws $(basename "${workspace%"/devel/share/common-lisp"}") ";
    done
  fi;
  if [[ -z "$ROSLISP_PACKAGE_DIRECTORIES" ]]; then
    ros_ws="";
  fi;

  rightLength=$((${#ros_ws}+${#venv}+${gitLength}));

  shortPWD=${PWD/${HOME}/"~"};
  if (( $(($(tput cols)-${rightLength}-${#shortPWD})) < 5 )); then
    shortPWD="$(basename "${PWD}")";
  fi;

  leftLength=$((${#shortPWD}));
  totalLength=$((${leftLength}+${rightLength}))
}

# Prompt virtualenv
function prompt_venv() {
  if [[ -n "$VIRTUAL_ENV" ]]; then
    echo -e "${orange}${venv}${reset}"
  else
    if [[ -n "$CONDA_PREFIX" ]]; then
      echo -e "${orange}${venv}${reset}"
    fi;
  fi;
}

# Prompt currently sourced ROS workspace
function prompt_ros_ws() {
  if [[ -n "$ROSLISP_PACKAGE_DIRECTORIES" ]]; then
    echo -e "${orange}${ros_ws}${reset}"
  fi;
}

# Prompt git
function prompt_git() {
  if [[ -n "$branch" ]]; then
    echo -e "${purple}${branch}${tan}${status}${cyan}${remote}${reset}";
  fi;
}

# Prompt command prompt
function prompt_command() {
  local p=""
  if (( EUID == 0 )); then
    p="\[${red}\]▶";
  else
    p="\[${blue}\]❯";
  fi;
  echo -e "${p} \[${reset}\]";
}

function prompt_align() {
  prompt_update;
  local offset=52;

  PLEFT="\[${tan}\]\h: \[${blue}\]${shortPWD}\[${reset}\]";
  PRIGHT="\$(prompt_ros_ws)\$(prompt_venv)\$(prompt_git)\[${reset}\]";

  PS1=$(printf "%s%*s\r%s\n%s" "$(set_title)" "$(($(tput cols)+${offset}-${rightLength}))" "$PRIGHT" "$PLEFT" "$(prompt_command)");
}
# prompt_align runs first so it can still see the last exit status.
# `history -a` makes new shells get the history lines from all previous
# shells instead of the default "last window closed" history.
PROMPT_COMMAND="prompt_align; history -a"
export PS1;

PS2="\[${cyan}\]→ \[${reset}\]";
export PS2;
