#!/bin/bash

# Syntax-highlight JSON strings or files
# Usage: `json '{"foo":42}'` or `echo '{"foo":42}' | json`
function json() {
  if [ -t 0 ]; then # argument
    python3 -m json.tool <<< "$*" | _json_highlight;
  else # pipe
    python3 -m json.tool | _json_highlight;
  fi;
}

# Highlight with pygmentize when available
function _json_highlight() {
  if type_exists pygmentize; then
    pygmentize -l json;
  else
    cat;
  fi;
}
