#!/bin/bash

# Load bash-completion: v2 needs bash >= 4.2, v1 also works with macOS' bash 3.2
# (_comp_load is the bash-completion >= 2.12 name of _completion_loader)
if ! shopt -oq posix && ! { declare -F _comp_load || declare -F _completion_loader; } &> /dev/null; then
  if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2) )); then
    _completion_files=(
      "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
      /usr/share/bash-completion/bash_completion
      /etc/bash_completion
      "${HOMEBREW_PREFIX}/etc/bash_completion"
    )
  else
    _completion_files=("${HOMEBREW_PREFIX}/etc/bash_completion")
  fi
  for _file in "${_completion_files[@]}"; do
    if [[ -r "$_file" ]]; then
      source "$_file"
      break
    fi
  done
  unset _file _completion_files
fi

# Git completion is not part of bash-completion everywhere (e.g. Apple's git)
if ! declare -F __git_complete &> /dev/null; then
  for _file in \
    "${HOMEBREW_PREFIX}/etc/bash_completion.d/git-completion.bash" \
    /usr/share/bash-completion/completions/git \
    /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash \
    /Applications/Xcode.app/Contents/Developer/usr/share/git-core/git-completion.bash; do
    if [[ -r "$_file" ]]; then
      source "$_file"
      break
    fi
  done
  unset _file
fi

# Tab-completion after typing cd to only suggest directories
complete -d cd

# Check https://gist.github.com/danpal/6283375
# Add completion for marks shortcuts
_completemarks() {
  local curw=${COMP_WORDS[COMP_CWORD]}
  local wordlist=$(find "$MARKPATH" -type l -exec basename {} \; 2> /dev/null)
  COMPREPLY=($(compgen -W '${wordlist[@]}' -- "$curw"))
  return 0
}
complete -F _completemarks jump unmark

# Enable git command autocompletion for 'g' as well
declare -F __git_complete &> /dev/null && __git_complete g __git_main

# Enable pip command autocompletion for `gpip` alias as well
declare -F _pip_completion &> /dev/null && complete -o default -F _pip_completion gpip gpip3

# Enable vagrant command autocompletion for `vg` alias as well
declare -F _vagrant &> /dev/null && complete -o default -F _vagrant vg

# Add tab completion for SSH hostnames based on ~/.ssh/config, ignoring wildcards
[ -e "$HOME/.ssh/config" ] && complete -o default -o nospace -W "$(grep "^Host" ~/.ssh/config | grep -v "[?*]" | cut -d " " -f2- | tr ' ' '\n')" scp sftp ssh;

# Conda autocompletion
type_exists conda && type_exists register-python-argcomplete && eval "$(register-python-argcomplete conda)"

# Keep sourcing this file from failing on the last test above
true
